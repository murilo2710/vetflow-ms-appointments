PORT=3002
# Sem SQL_CONNECTION_STRING o serviço roda em memória (somente desenvolvimento).
SQL_CONNECTION_STRING=Server=tcp:SEU-SERVIDOR.database.windows.net,1433;Database=vetflow-agenda;User Id=USUARIO;Password=SENHA;Encrypt=true;TrustServerCertificate=false;Connection Timeout=60
# Azure Service Bus (fila vetflow-eventos). Sem ele, os eventos só aparecem no log.
SERVICEBUS_CONNECTION=Endpoint=sb://SEU-NAMESPACE.servicebus.windows.net/;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=CHAVE
SERVICEBUS_QUEUE=vetflow-eventos
# Alternativa local: enviar eventos para a Function por HTTP
# EVENTS_HTTP_URL=http://localhost:7071/api/eventos
OUTBOX_INTERVAL_MS=5000
CORS_ORIGIN=*
